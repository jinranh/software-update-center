[Desktop Entry]
Type=Application
Name=软件更新
Name[en]=Software Update Center
Comment=查找并安装常用应用，集中管理更新
Comment[en]=Find and install desktop apps and manage their updates
Exec=/bin/sh -c "exec /usr/bin/python3 ~/.local/share/software-update-center/app.py"
Icon=system-software-update
Terminal=false
Categories=System;
StartupNotify=true
StartupWMClass=app.py
